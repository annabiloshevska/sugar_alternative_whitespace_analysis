      <aliases enabled='yes' />
      <column caption='Priority Color' datatype='string' name='[Calculation_1815600531746816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [category] = &quot;Candy&quot; THEN &quot;#2ECC71&quot;&#13;&#10;ELSEIF [category] = &quot;Chocolate&quot; THEN &quot;#2ECC71&quot;&#13;&#10;ELSEIF [category] = &quot;Wholesome Snacks&quot; THEN &quot;#2ECC71&quot;&#13;&#10;ELSEIF [priority] = &quot;MEDIUM&quot; THEN &quot;#F39C12&quot;&#13;&#10;ELSE &quot;#95A5A6&quot;&#13;&#10;END' />
      </column>
      <column caption='Product_Family' datatype='string' name='[Calculation_1815600783167489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// CANDY FAMILIES&#13;&#10;IF CONTAINS(UPPER([description]), &quot;GUMMY&quot;) OR CONTAINS(UPPER([description]), &quot;GUMMI&quot;) THEN &quot;Gummy Candy&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;SOUR&quot;) THEN &quot;Sour Candy&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;JELLY BEAN&quot;) THEN &quot;Jelly Beans&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;JELLY&quot;) AND NOT CONTAINS(UPPER([description]), &quot;BEAN&quot;) THEN &quot;Jelly Candy&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;PEPPERMINT&quot;) THEN &quot;Peppermint&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;CARAMEL&quot;) AND [branded_food_category] = &quot;Candy&quot; THEN &quot;Caramel Candy&quot;&#13;&#10;&#13;&#10;// FRUIT FLAVORS → All become &quot;Fruit Candy&quot;&#13;&#10;ELSEIF (CONTAINS(UPPER([description]), &quot;STRAWBERRY&quot;) &#13;&#10;     OR CONTAINS(UPPER([description]), &quot;CHERRY&quot;) &#13;&#10;     OR CONTAINS(UPPER([description]), &quot;ORANGE&quot;)&#13;&#10;     OR CONTAINS(UPPER([description]), &quot;GRAPE&quot;)&#13;&#10;     OR CONTAINS(UPPER([description]), &quot;LEMON&quot;)&#13;&#10;     OR CONTAINS(UPPER([description]), &quot;RASPBERRY&quot;)&#13;&#10;     OR CONTAINS(UPPER([description]), &quot;WATERMELON&quot;)&#13;&#10;     OR CONTAINS(UPPER([description]), &quot;APPLE&quot;)&#13;&#10;     OR CONTAINS(UPPER([description]), &quot;FRUIT&quot;)) &#13;&#10;     AND [branded_food_category] = &quot;Candy&quot; THEN &quot;Fruit Candy&quot;&#13;&#10;&#13;&#10;ELSEIF (CONTAINS(UPPER([description]), &quot;CHOCOLATE CANDIES&quot;) OR CONTAINS(UPPER([description]), &quot;MILK CHOCOLATE CANDIES&quot;)) &#13;&#10;       AND [branded_food_category] = &quot;Candy&quot; THEN &quot;Chocolate Covered Candy&quot;&#13;&#10;&#13;&#10;// CHOCOLATE FAMILIES&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;MILK CHOCOLATE&quot;) AND [branded_food_category] = &quot;Chocolate&quot; THEN &quot;Milk Chocolate&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;DARK CHOCOLATE&quot;) THEN &quot;Dark Chocolate&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;TRUFFLE&quot;) THEN &quot;Truffles&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;CARAMEL&quot;) AND [branded_food_category] = &quot;Chocolate&quot; THEN &quot;Chocolate Caramels&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;PEPPERMINT&quot;) AND [branded_food_category] = &quot;Chocolate&quot; THEN &quot;Chocolate Peppermint&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;HAZELNUT&quot;) THEN &quot;Chocolate Hazelnut&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;BARK&quot;) THEN &quot;Chocolate Bark&quot;&#13;&#10;&#13;&#10;// WHOLESOME SNACKS FAMILIES&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;RAISIN&quot;) THEN &quot;Raisins&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;DRIED MANGO&quot;) OR (CONTAINS(UPPER([description]), &quot;MANGO&quot;) AND CONTAINS(UPPER([description]), &quot;DRIED&quot;)) THEN &quot;Dried Mango&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;DRIED CRANBERR&quot;) OR (CONTAINS(UPPER([description]), &quot;CRANBERR&quot;) AND CONTAINS(UPPER([description]), &quot;DRIED&quot;)) THEN &quot;Dried Cranberries&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;DRIED APPLE&quot;) OR (CONTAINS(UPPER([description]), &quot;APPLE&quot;) AND CONTAINS(UPPER([description]), &quot;DRIED&quot;)) THEN &quot;Dried Apples&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;FREEZE&quot;) AND CONTAINS(UPPER([description]), &quot;DRIED&quot;) THEN &quot;Freeze-Dried Fruit&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;DRIED STRAWBERR&quot;) OR (CONTAINS(UPPER([description]), &quot;STRAWBERR&quot;) AND CONTAINS(UPPER([description]), &quot;DRIED&quot;)) THEN &quot;Dried Strawberries&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;DRIED PINEAPPLE&quot;) OR (CONTAINS(UPPER([description]), &quot;PINEAPPLE&quot;) AND CONTAINS(UPPER([description]), &quot;DRIED&quot;)) THEN &quot;Dried Pineapple&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;DATE&quot;) AND [branded_food_category] = &quot;Wholesome Snacks&quot; THEN &quot;Dates&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;DRIED&quot;) AND [branded_food_category] = &quot;Wholesome Snacks&quot; THEN &quot;Other Dried Fruit&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
