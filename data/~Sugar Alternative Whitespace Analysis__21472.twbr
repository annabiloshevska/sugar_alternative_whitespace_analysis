            <column-instance column='[has_sugar_alternative]' derivation='None' name='[none:has_sugar_alternative:nk]' pivot='key' type='nominal' />
            <column-instance column='[sugar_100g]' derivation='None' name='[none:sugar_100g:ok]' pivot='key' type='ordinal' />
