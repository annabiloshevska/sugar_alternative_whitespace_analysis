      <column caption='Priority Color' datatype='string' name='[Calculation_1815600531746816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [priority] = &quot;HIGH&quot; THEN &quot;#2ECC71&quot;&#13;&#10;ELSEIF [priority] = &quot;MEDIUM&quot; THEN &quot;#F39C12&quot;&#13;&#10;ELSE &quot;#95A5A6&quot;&#13;&#10;END' />
      </column>
      <column caption='Product_Family' datatype='string' name='[Calculation_1815600783167489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(UPPER([description]), &quot;COTTON CANDY&quot;) THEN &quot;Cotton Candy&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;GUMMY&quot;) OR CONTAINS(UPPER([description]), &quot;GUMMI&quot;) THEN &quot;Gummy Candy&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;LOLLIPOP&quot;) OR CONTAINS(UPPER([description]), &quot;LOLLY&quot;) THEN &quot;Lollipops&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;SKITTLES&quot;) THEN &quot;Skittles&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;M&amp;M&quot;) THEN &quot;M&amp;Ms&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;CHOCOLATE BAR&quot;) THEN &quot;Chocolate Bars&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;JELLY BEAN&quot;) THEN &quot;Jelly Beans&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;HARD CANDY&quot;) THEN &quot;Hard Candy&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;MINT&quot;) THEN &quot;Mints&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;DRIED FRUIT&quot;) OR CONTAINS(UPPER([description]), &quot;FREEZE-DRIED&quot;) THEN &quot;Dried Fruit&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;GRANOLA&quot;) THEN &quot;Granola&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;FRUIT SNACK&quot;) THEN &quot;Fruit Snacks&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;CARAMEL&quot;) THEN &quot;Caramels&quot;&#13;&#10;ELSEIF CONTAINS(UPPER([description]), &quot;TAFFY&quot;) THEN &quot;Taffy&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
